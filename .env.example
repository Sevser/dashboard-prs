# Copy this file to .env before starting DevLake.
# Use unique values and keep the resulting .env file private.

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=lake
MYSQL_USER=merico
MYSQL_PASSWORD=replace-with-a-strong-database-password

# Exactly 128 uppercase ASCII letters. Keep this value for the life of the
# installation: DevLake uses it to encrypt GitHub tokens and other secrets.
ENCRYPTION_SECRET=ABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOPQRSTUVWX
